# Caddy in front of the site. Caddy gets and renews the HTTPS certificate on
# its own once kirtankunwar.com and www.kirtankunwar.com point at this server.
#
# Install once:  sudo cp Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
# (If this server's Caddy already serves other sites, paste these two blocks
#  into the existing /etc/caddy/Caddyfile instead of replacing it.)

kirtankunwar.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@static path /_next/static/* /fonts/* /paper/*
	header @static Cache-Control "public, max-age=31536000, immutable"
}

www.kirtankunwar.com {
	redir https://kirtankunwar.com{uri} permanent
}
